# --- DJANGO CORE ---
SECRET_KEY=tvoj-super-tajni-key-ovdje
DEBUG=True

# --- Postgres ---
ENGINE=django.db.backends.postgresql
NAME=postgres
USER=postgres
PASSWORD=postgres
HOST=pgdb
PORT=5432

# --- CELERY & REDIS ---
CELERY_BROKER_URL=redis://redis_broker:6379/0
CELERY_RESULT_BACKEND=redis://redis_broker:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Europe/Paris

# --- EMAIL SETTINGS (Gmail SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=tvoj_email@gmail.com
EMAIL_HOST_USER=tvoj_email@gmail.com
EMAIL_HOST_PASSWORD=tvoja-lozinka-aplikacije

# --- PDF ---
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf